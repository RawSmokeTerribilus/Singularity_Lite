# --- BLOQUEO DE SECRETOS (NIVEL BÚNKER) ---
.env
**/.env
**/config.py
**/singularity_config.py
**/mass_config.py

# --- PERMITIR TUS "EXAAMPLES" (DOBLE A) ---
!**/*.exaample
# Por si acaso aún tienes alguno con una sola A:
!**/*.example.py
!**/*.example

# --- BASURA DE SISTEMA Y LOGS ---
**/__pycache__/
**/*.log
.git/
.zenflow/
logs/
tmp/

# --- LIMPIEZA DE REPORTES Y DOCS PERSONALES ---
audit_report_singularity.txt
refactor_log.txt
init-structure.txt
Executive_resume.md
docs/
mkdocs.yml
**/*.bkp
**/*.bak*

# --- SCRIPTS DE CONTROL DEL HOST ---
.dockerignore
.gitignore
install-commands.sh
makefile

# Bloqueo de la carpeta de archivados del Mass Editor
extras/MASS-EDITION-UNIT3D/archive/
**/MASS-EDITION-UNIT3D/archive/
**/*.tsv

# --- ESTADO DE EJECUCIÓN DEL REPO DE DEV ---
# work_data/ es el estado vivo de quien construye (logs, temporales, informes,
# datos del editor masivo). Las carpetas se quedan --/app/work_data/tmp es la
# caché de universal_rescuer.py y reports/ un punto de montaje--, su contenido
# no: rc1 se publicó con lo que hubiera ahí (por suerte, nada sensible).
work_data/tmp/*
work_data/logs/*
work_data/reports/*
work_data/mass_editor/*
work_data/cookies*
