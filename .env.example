# ============================================================================
#  Singularity Lite — DOCKER COMPOSE environment
#  Copy to  ./.env  (the installer does this for you).
# ============================================================================
#
#  This file is read by DOCKER COMPOSE, for ${...} interpolation in
#  docker-compose.yml. It is NOT the application config.
#
#  The application's tracker cookies, API keys and ME_* settings live in
#  ./config/.env  (template: config/.env.example). Compose cannot interpolate
#  from that file — `env_file:` values are only passed into the container, they
#  are not available to the compose file itself. Hence two files.
# ============================================================================

# --- Ownership -------------------------------------------------------------
# The UID/GID the container runs as. Must own ./config and ./work_data on the
# host, or the app cannot write its own configuration back out.
# Find yours with: id -u ; id -g
PUID=1000
PGID=1000

# --- Timezone --------------------------------------------------------------
# e.g. Europe/Madrid, America/New_York, Etc/UTC
TZ=Etc/UTC

# --- Media library ---------------------------------------------------------
# REQUIRED. Compose refuses to start without it.
#
# Mounted at the SAME path inside the container as outside, so a path you type
# into the TUI, and a path your Sonarr/Radarr already stores, both resolve
# identically. Point it at the top of your library.
#
#   Raspberry Pi / generic Linux : /mnt/media
#   Synology                     : /volume1/data
#   Unraid                       : /mnt/user/data
#   TrueNAS                      : /mnt/tank/media
#
# If your library spans several mounts, add extra lines to the volumes: block
# in docker-compose.yml in the same shape.
MEDIA_ROOT=/mnt/media
