# Namespace propio en el .env: prefijo ME_
# Uso standalone: edita los fallbacks de os.getenv() directamente.
# Uso via singularity/Docker: los ME_* del .env tienen prioridad.

import os
from pathlib import Path

try:
    from dotenv import load_dotenv
    _here = Path(__file__).resolve().parent
    for _ep in [_here / ".env", _here / "../../.env", Path("/app/.env")]:
        if _ep.exists():
            load_dotenv(_ep)
            break
except ImportError:
    pass

# ─── 1. Credenciales y Tracker (namespace ME_) ────────────────────────────────
