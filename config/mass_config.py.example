# ==========================================
# ⚙️ UNIT3D MASS EDITION SUITE - CONFIG
# ==========================================
# Namespace propio en el .env: prefijo ME_
# Uso standalone: edita los fallbacks de os.getenv() directamente.
# Uso via singularity/Docker: los ME_* del .env tienen prioridad.

import os
from pathlib import Path

# ─── 0. Autocuración del .env ────────────────────────────────────────────────
# Un .env existente NO se regenera al reconstruir la imagen: es un fichero del
# host montado dentro. Así que quien viene de una versión anterior se queda sin
# las claves nuevas y hereda los valores por defecto del código sin enterarse —
# y peor, sin poder cambiarlos desde el .env porque ni siquiera aparecen.
#
# ENV_DEFAULTS es la lista de claves que este módulo espera. ensure_env_keys()
# añade SÓLO las que falten, nunca toca un valor ya escrito, y no hace nada si
# están todas: es idempotente, se puede llamar en cada arranque.
ENV_DEFAULTS = [
    ("ME_DEAD_HOSTS",        "imgbox.com,pixhost.to", "Hosts de imágenes caídos que disparan la regeneración"),
    ("ME_REGEN_IMG_HOST",    "",                      "Destino de las capturas. Vacío = primer img_host_N vivo de RawLoadrr"),
    ("ME_REGEN_SCREENS",     "",                      "Nº de capturas. Vacío = tantas como imágenes haya que reponer"),
    ("ME_REGEN_KEEP_PNG",    "0",                     "1 conserva los PNG en tmp; 0 los borra tras subirlos"),
    ("ME_REGEN_DRY_RUN",     "0",                     "1 = simulacro. Los flags --real/--dry-run mandan sobre esto"),
    ("ME_REGEN_IMG_SIZE",    "350",                   "Ancho del [img=N] si la etiqueta original no traía uno"),
    ("ME_REGEN_STATE_DIR",   "",                      "Dónde viven mapeo_qbit_*.json y completados_regen_*.txt. Vacío = directorio actual"),
    ("ME_REGEN_ALL",         "0",                     "1 = procesa todo el cliente e ignora ID_START/ID_END"),
    ("ME_REGEN_LIMIT",       "0",                     "Tope de torrents por tirada. 0 = sin tope"),
    ("ME_REGEN_MAX_FALLOS",  "15",                    "Fallos seguidos tras los que se aborta la tirada"),
]


def _localizar_env():
    """Mismo orden de búsqueda que el cargador de abajo."""
    aqui = Path(__file__).resolve().parent
    for ruta in (aqui / ".env", aqui / "../../.env", Path("/app/.env")):
        if ruta.exists():
            return ruta.resolve()
    return (aqui / "../../.env").resolve()


def ensure_env_keys(env_path=None, verbose=True):
    """Añade al .env las claves que falten. Devuelve la lista de añadidas.

    - No modifica ningún valor existente (ni siquiera si está vacío).
    - Idempotente: la segunda llamada no añade nada.
    - Escribe in situ (r+ y truncate), nunca os.replace: el .env suele ser un
      bind-mount de fichero único y sustituirlo rompe el inodo del contenedor.
    - Si el fichero no existe, lo crea.
    """
    ruta = Path(env_path) if env_path else _localizar_env()
    try:
        texto = ruta.read_text(encoding="utf-8") if ruta.exists() else ""
    except OSError:
        return []

    presentes = set()
    for linea in texto.splitlines():
        limpia = linea.strip()
        if not limpia or limpia.startswith("#") or "=" not in limpia:
            continue
        presentes.add(limpia.split("=", 1)[0].strip())

    faltan = [(k, v, c) for k, v, c in ENV_DEFAULTS if k not in presentes]
    if not faltan:
        return []

    nuevo = texto
    if nuevo and not nuevo.endswith("\n"):
        nuevo += "\n"
    nuevo += "\n# --- Mass Edition · regeneración de imágenes (añadido automáticamente) ---\n"
    for k, v, c in faltan:
        nuevo += f"# {c}\n{k}={v}\n"

    try:
        ruta.parent.mkdir(parents=True, exist_ok=True)
        with open(ruta, "r+" if ruta.exists() else "w", encoding="utf-8") as f:
            f.write(nuevo)
            f.truncate()
    except OSError as e:
        if verbose:
            print(f"⚠️  No se pudo completar {ruta}: {e}")
        return []

    if verbose:
        print(f"🔧 {ruta.name} completado con {len(faltan)} clave(s) nueva(s): "
              + ", ".join(k for k, _v, _c in faltan))
    return [k for k, _v, _c in faltan]


try:
    from dotenv import load_dotenv
    _here = Path(__file__).resolve().parent
    # Claves que se pasan por ejecución (el TUI las exporta al lanzar el
    # subproceso, y el README documenta `export ID_START=…` para uso suelto).
    # Éstas mandan sobre el fichero; el resto, no. Ver el comentario de abajo.
    _RUNTIME_KEYS = ("ID_START", "ID_END", "ID_FILENAME", "EDIT_MODE",
                     "ME_REGEN_ALL", "ME_REGEN_DRY_RUN", "ME_REGEN_KEEP_PNG",
                     "ME_REGEN_SCREENS", "ME_REGEN_IMG_HOST", "ME_DEAD_HOSTS",
                     "ME_REGEN_LIMIT", "ME_REGEN_MAX_FALLOS")
    _runtime = {k: os.environ[k] for k in _RUNTIME_KEYS if k in os.environ}

    for _ep in [_here / ".env", _here / "../../.env", Path("/app/.env")]:
        if _ep.exists():
            # override=True es obligatorio: el compose usa `env_file: ./config/.env`,
            # así que los valores del .env quedan CONGELADOS en el entorno del
            # contenedor cuando arranca. Sin override, load_dotenv respeta ese
            # entorno viejo y cualquier cambio hecho desde el TUI (_write_env_key)
            # es invisible para los procesos nuevos: el módulo seguiría apuntando
            # al tracker anterior con la cookie y la API key anteriores.
            load_dotenv(_ep, override=True)
            break

    # Completar el .env con las claves nuevas y recargar, para que un fichero
    # heredado de una versión anterior no deje al usuario sin poder configurarlas.
    try:
        if ensure_env_keys(_ep if '_ep' in dir() else None):
            load_dotenv(_ep, override=True)
    except Exception:
        pass

    # …pero lo que venga explícito en esta ejecución vuelve a ganar.
    os.environ.update(_runtime)
except ImportError:
    pass

# ─── 0b. Lectura estricta de banderas ────────────────────────────────────────
# "cualquier cosa que no sea 0 es verdadero" es una trampa: un valor como "n",
# "no" o "false" se leía como VERDADERO y dejaba la herramienta encerrada en
# simulacro pasara lo que pasara. Aquí sólo valen tokens reconocidos, y lo que
# no se reconozca avisa y se toma como falso en vez de decidir en silencio.
_CIERTO = {"1", "true", "yes", "y", "on", "si", "sí", "s", "t"}
_FALSO  = {"0", "false", "no", "n", "off", "", "none", "null", "f"}


def flag(nombre, por_defecto="0"):
    crudo = os.getenv(nombre, por_defecto)
    v = str(crudo).strip().strip("'\"").lower()
    if v in _CIERTO:
        return True
    if v in _FALSO:
        return False
    print(f"⚠️  {nombre}={crudo!r} no se entiende; lo trato como desactivado. "
          f"Usa 1/0.")
    return False


