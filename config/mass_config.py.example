BANNER_IMG_NUEVA = os.getenv("BANNER_IMG_NUEVA", "")
FIRMA_TEXT_NUEVA = os.getenv("FIRMA_TEXT_NUEVA", "")
FIRMA_FULL_NUEVA = os.getenv("FIRMA_FULL_NUEVA", "")
FIND_URL         = os.getenv("FIND_URL",         "")
REPLACE_URL      = os.getenv("REPLACE_URL",      "")
BLOCK_VIEJO      = os.getenv("BLOCK_VIEJO",      "")
BLOCK_NUEVO      = os.getenv("BLOCK_NUEVO",      "")

# ─── 6. Textos estáticos ──────────────────────────────────────────────────────
MSG_VIEJO = "[center][b]PLEASE SEED MILNUEVE FAMILY[/b][/center]"
MSG_NUEVO = "[center][b]🌱 ¡La magia del P2P eres tú! Por favor, quédate compartiendo (seeding) para mantener viva la comunidad. 🌱[/b][/center]"

BANNER_VIEJO = "[center][url=https://codeberg.org/CvT/Uploadrr][img=400]https://i.ibb.co/2NVWb0c/uploadrr.webp[/img][/url][/center]"
BANNER_NUEVO = "[center][url=https://codeberg.org/RawSmoke/Singularity][img=400]https://i.ibb.co/0RrzLmSr/RAW-bruma-servers.png[/img][/url][/center]"

FIRMAS_VIEJAS = [
    "[center][b]PLEASE SEED MILNUEVE FAMILY[/b][/center]",
    "[center][url=https://codeberg.org/CvT/Uploadrr][img=400]https://i.ibb.co/2NVWb0c/uploadrr.webp[/img][/url][/center]",
]

# ─── 7. Settings del bot ──────────────────────────────────────────────────────
DELAY_MIN = float(os.getenv("ME_DELAY_MIN", "4.5"))
DELAY_MAX = float(os.getenv("ME_DELAY_MAX", "7.5"))

# ─── 7b. Regeneración de imágenes (05_image_regenerator) ─────────────────────
# Hosts de imágenes muertos: si la descripción del tracker apunta a alguno de
# ellos, el torrent entra en la cola de regeneración. Lista separada por comas.
DEAD_HOSTS = [
    h.strip().lower()
    for h in os.getenv("ME_DEAD_HOSTS", "imgbox.com,pixhost.to").split(",")
    if h.strip()
]

# Host de destino para las capturas nuevas. Vacío = usa el primer img_host_N de
# RawLoadrr que no esté en DEAD_HOSTS. No introduce credenciales nuevas: las
# API keys siguen viniendo de RawLoadrr/data/config.py.
REGEN_IMG_HOST = os.getenv("ME_REGEN_IMG_HOST", "").strip().lower()

# Nº de capturas por torrent. Vacío = usa DEFAULT.screens de RawLoadrr.
REGEN_SCREENS = os.getenv("ME_REGEN_SCREENS", "").strip()

# 1 = conserva los PNG en tmp/. 0 = los borra tras subirlos con éxito y deja
# solo MediaInfo.json + meta.json + DESCRIPTION.txt (unos cientos de KB por
# torrent en vez de ~13 MB).
REGEN_KEEP_PNG = os.getenv("ME_REGEN_KEEP_PNG", "0").strip() not in ("0", "", "false", "False")

# 1 = no escribe nada en el tracker; imprime el diff de la descripción.
REGEN_DRY_RUN = os.getenv("ME_REGEN_DRY_RUN", "0").strip() not in ("0", "", "false", "False")

# Ancho del [img=N] en el BBCode nuevo (mismo formato que COMMON.py).
REGEN_IMG_SIZE = os.getenv("ME_REGEN_IMG_SIZE", "350").strip()

# Directorio donde viven los ficheros de estado (mapeo_qbit.json,
# completados_regen.txt). Por defecto el cwd, igual que 01-04.
REGEN_STATE_DIR = os.getenv("ME_REGEN_STATE_DIR", "").strip() or "."

# 1 = procesa TODO lo que haya en el cliente para este tracker e ignora
# ID_START/ID_END. El mapa del cliente ya es la lista real de torrents del
# usuario, así que los rangos sólo estorban.
REGEN_ALL = os.getenv("ME_REGEN_ALL", "0").strip() not in ("0", "", "false", "False")

# Tope de torrents por tirada (0 = sin tope). Sirve para hacer la primera
# pasada en lotes pequeños y revisar el resultado antes de soltar las 3000.
REGEN_LIMIT = int(os.getenv("ME_REGEN_LIMIT", "0") or 0)


# ─── 8. Utilidades ────────────────────────────────────────────────────────────
def filter_ids_by_range(ids):
    """Filtra una lista de IDs (strings) por el rango ID_START/ID_END.

    get_target_ids() depende de ids.txt (lo genera 01_scraper). 05 construye su
    propia lista desde el cliente torrent, así que necesita el filtro suelto.
    """
    out = []
    for tid in ids:
        try:
            if ID_INICIO <= int(tid) <= ID_FIN:
                out.append(str(tid))
        except (TypeError, ValueError):
            continue
    return sorted(out, key=int)


def get_target_ids():
    """Retorna la lista final de IDs a procesar (de ids.txt filtrada por rango)."""
    ids = []
    if os.path.exists(ID_FILE):
        with open(ID_FILE, "r") as f:
            for line in f:
                stripped = line.strip()
                if not stripped:
                    continue
                try:
                    int(stripped)
                    ids.append(stripped)
                except ValueError:
                    pass
    if ids:
        return [tid for tid in ids if ID_INICIO <= int(tid) <= ID_FIN]
    return [str(i) for i in range(ID_INICIO, ID_FIN + 1)]
