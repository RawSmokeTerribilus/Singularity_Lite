# ─── 7b. Regeneración de imágenes (05_image_regenerator) ─────────────────────
# Hosts de imágenes muertos: si la descripción del tracker apunta a alguno de
# ellos, el torrent entra en la cola de regeneración. Lista separada por comas.
DEAD_HOSTS = [
    h.strip().lower()
    for h in os.getenv("ME_DEAD_HOSTS", "imgbox.com,pixhost.to").split(",")
    if h.strip()
]

# Host de destino para las capturas nuevas. Vacío = usa el primer img_host_N de
