# --- TRACKER CORE (NOBS defaults shipped) ---
TRACKER_BASE_URL=https://nobs.rawsmoke.net
TRACKER_ABBREV=NOBS
TRACKER_USERNAME=TuUsuario
TRACKER_COOKIE_NAME=nuclear_order_bit_syndicate_session
TRACKER_COOKIE_VALUE=
CUSTOM_USER_AGENT=undici

# --- MASS EDITION / UNIT3D ORCHESTRATOR (same tracker by default) ---
ME_TRACKER_URL=https://nobs.rawsmoke.net
ME_TRACKER_DEFAULT=NOBS
ME_TRACKER_USERNAME=TuUsuario
ME_TRACKER_COOKIE_NAME=nuclear_order_bit_syndicate_session
ME_TRACKER_COOKIE=
ME_TRACKER_API_KEY=
# Must match CUSTOM_USER_AGENT above. A browser-like UA here is what causes a
# 403 on the very first scrape against a tracker whose WAF expects the client
# UA — the mismatch between these two lines cost a user two days.
ME_CUSTOM_USER_AGENT=undici
ME_TMP_ROOT=/app/RawLoadrr/tmp
ME_DELAY_MIN=4.5
ME_DELAY_MAX=7.5

# --- APIs / IMAGE HOSTS ---
TMDB_API_KEY=
TVDB_API_KEY=
IMDB_API_KEY=
IMGBB_API_KEY=
PTSCREENS_API_KEY=
ME_IMGBB_API=
ME_PTSCREENS_API=

# --- PATHS ---
TMP_ROOT=/app/RawLoadrr/tmp
TMP_PATH=/app/RawLoadrr/tmp
QBIT_BACKUP_DIR=${HOME}/Qbit_Docker/config/qBittorrent/BT_backup

# --- RANGE / IDS ---
ID_START=14
ID_END=2000
ID_FILENAME=ids.txt

# --- OPTIONAL EXTERNAL SERVICES ---
SONARR_URL=http://127.0.0.1:8989
SONARR_API_KEY=
RADARR_URL=http://127.0.0.1:7878
RADARR_API_KEY=

# --- WEB DASHBOARD ---
# The dashboard has NO authentication. It only shows what the suite is doing
# (module, job name, progress), but that is still your library on display.
#
# Default is loopback-only, so it is reachable at http://localhost:8002 from
# the machine running the container and from nowhere else.
#
# On a headless box — NAS, Raspberry Pi — the browser is on another machine, so
# loopback refuses the connection. Two options:
#
#   1. SSH tunnel, nothing exposed (recommended):
#        ssh -N -L 8002:127.0.0.1:8002 user@your-box
#      then open http://localhost:8002 on your own machine.
#
#   2. Serve it to your LAN by uncommenting the line below. Anyone on the
#      network can then read it, with no password. Only do this on a network
#      you trust, and never forward the port through a router.
#
#DASHBOARD_HOST=0.0.0.0
